{
  "name": "youtube-deep-analyzer",
  "version": "1.3.1",
  "description": "Caption-first YouTube analysis with selective local STT and targeted visual inspection.",
  "author": {
    "name": "YouTube Deep Analyzer contributors"
  },
  "license": "MIT",
  "keywords": [
    "youtube",
    "captions",
    "transcript",
    "video-analysis"
  ],
  "mcpServers": {
    "youtube-media": {
      "command": "python3",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/scripts/launch_mcp.py"
      ],
      "startup_timeout_sec": 60,
      "tool_timeout_sec": 21600
    }
  }
}
